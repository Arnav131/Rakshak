# .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# Django
db.sqlite3
*.sqlite
*.sqlite3
db.sqlite3-journal
staticfiles/
media/

# Virtual environment
venv/
env/
.venv/
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Raw GIS temporary downloads
raw_overpass_railway.json
*.pbf
*.mbtiles
*.pmtiles
*.shp
*.zip

# Prevent accidental binary/scratch pipeline artifacts in repo root
/temp_pipeline.py
**/temp_pipeline.py
